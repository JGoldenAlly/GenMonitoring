<?xml version="1.0"?>
<Container version="2">
  <Name>genmonitoring-api</Name>
  <Repository>ghcr.io/jgoldenally/genmonitoring-api:latest</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/jgoldenally/genmonitoring/issues</Support>
  <Overview>GenMonitoring API -- FastAPI backend for the Ally Energy generator monitoring platform. Handles field-device claiming, Modbus register templates, telemetry queries, and the generator start/stop command channel. Requires a reachable Postgres+TimescaleDB instance and the genmonitoring-bridge's Mosquitto broker.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8000]/docs</WebUI>
  <Icon>https://raw.githubusercontent.com/jgoldenally/genmonitoring/main/assets/icon.png</Icon>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <DateInstalled></DateInstalled>
  <DonateLink></DonateLink>
  <Config Type="Port" Name="API Port" Target="8000" Default="8000" Mode="tcp" Description="REST API + gated /docs">8000</Config>
  <Config Type="Variable" Name="DATABASE_URL" Target="DATABASE_URL" Default="postgresql+asyncpg://genmon:genmon@postgres:5432/genmonitoring" Mode="" Description="SQLAlchemy async connection string for Postgres/TimescaleDB" Display="always" Required="true" Mask="true">postgresql+asyncpg://genmon:genmon@postgres:5432/genmonitoring</Config>
  <Config Type="Variable" Name="JWT_SECRET" Target="JWT_SECRET" Default="" Mode="" Description="Random secret for signing JWTs -- generate with `openssl rand -hex 32`" Display="always" Required="true" Mask="true"></Config>
  <Config Type="Variable" Name="JWT_ALGORITHM" Target="JWT_ALGORITHM" Default="HS256" Mode="" Description="JWT signing algorithm" Display="advanced" Required="false" Mask="false">HS256</Config>
  <Config Type="Variable" Name="JWT_ACCESS_TOKEN_EXPIRE_MINUTES" Target="JWT_ACCESS_TOKEN_EXPIRE_MINUTES" Default="30" Mode="" Description="Access token lifetime (minutes)" Display="advanced" Required="false" Mask="false">30</Config>
  <Config Type="Variable" Name="JWT_REFRESH_TOKEN_EXPIRE_DAYS" Target="JWT_REFRESH_TOKEN_EXPIRE_DAYS" Default="30" Mode="" Description="Refresh token lifetime (days)" Display="advanced" Required="false" Mask="false">30</Config>
  <Config Type="Variable" Name="MQTT_HOST" Target="MQTT_HOST" Default="" Mode="" Description="Mosquitto broker hostname/IP" Display="always" Required="true" Mask="false"></Config>
  <Config Type="Variable" Name="MQTT_PORT" Target="MQTT_PORT" Default="8883" Mode="" Description="Mosquitto broker port" Display="always" Required="true" Mask="false">8883</Config>
  <Config Type="Variable" Name="MQTT_TLS" Target="MQTT_TLS" Default="true" Mode="" Description="Use TLS for the broker connection" Display="advanced" Required="false" Mask="false">true</Config>
  <Config Type="Variable" Name="MQTT_USERNAME" Target="MQTT_USERNAME" Default="genmon-api" Mode="" Description="Dynamic-security admin account used to provision per-device MQTT credentials and publish start/stop commands" Display="always" Required="true" Mask="false">genmon-api</Config>
  <Config Type="Variable" Name="MQTT_PASSWORD" Target="MQTT_PASSWORD" Default="" Mode="" Description="Password for MQTT_USERNAME (see mosquitto/bootstrap-dynsec.sh)" Display="always" Required="true" Mask="true"></Config>
  <Config Type="Variable" Name="CORS_ORIGINS" Target="CORS_ORIGINS" Default="" Mode="" Description="Comma-separated origins allowed to call this API (e.g. the portal's URL)" Display="always" Required="true" Mask="false"></Config>
  <Config Type="Variable" Name="AGENT_SCRIPT_PATH" Target="AGENT_SCRIPT_PATH" Default="/app/agent/genmon_agent.py" Mode="" Description="Path inside the container to the bundled agent script served by GET /devices/agent/download" Display="advanced" Required="false" Mask="false">/app/agent/genmon_agent.py</Config>
</Container>
